server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # The build talks to its own origin only; everything else is refused. The
  # base URI is 'self' so a preview gateway may mount the app with <base href>.
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # ^~ keeps the regex location below from capturing an API path that happens
  # to carry an /assets/ segment.
  location ^~ /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
  }

  # Vite fingerprints the file names, so they can be cached for a year.
  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  # The build uses relative asset URLs, so a bookmark reloaded at the site root
  # on a nested route asks for /order-review/assets/... or
  # /order-confirmation/<id>/assets/... . Serve any of those from the build's
  # own assets folder. nginx resolves ../ before matching, so the capture
  # cannot leave /assets.
  location ~ ^/.+/assets/(?<build_asset>.+)$ {
    try_files /assets/$build_asset =404;
    expires 1y;
  }

  location = /index.html {
    expires -1;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
